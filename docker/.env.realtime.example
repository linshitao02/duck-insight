# 复制本文件为 docker/.env.realtime 后按实际环境修改
# 注意：docker/.env.realtime 已被 .gitignore 忽略，不要把真实密码提交到 Git

# ---- MySQL 业务源库（开启 Binlog ROW + GTID）----
RT_MYSQL_ROOT_PASSWORD=ChangeMe_StrongPwd_2026
RT_MYSQL_DATABASE=ecommerce
RT_MYSQL_BIND=127.0.0.1
RT_MYSQL_PORT=3307

# ---- Kafka (KRaft) ----
# 如需局域网其他机器直连 Kafka，将以下两项改为宿主机局域网 IP（生产环境建议配合防火墙限制来源）
KAFKA_EXTERNAL_BIND=127.0.0.1
KAFKA_EXTERNAL_HOST=127.0.0.1
KAFKA_EXTERNAL_PORT=9094
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ---- Flink ----
FLINK_REST_BIND=127.0.0.1
FLINK_REST_PORT=8081
FLINK_TASK_SLOTS=4

# ---- Apache Doris ----
DORIS_QUERY_BIND=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_HTTP_BIND=127.0.0.1
DORIS_HTTP_PORT=8030
DORIS_DATABASE=dw_ecommerce

# ---- Duck Insight 后端连接实时栈（叠加启动 docker-compose.yml 时生效）----
FLINK_REST_URL=http://jobmanager:8081
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_ADMIN_BOOTSTRAP=kafka:9092
DORIS_HOST=doris-fe
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_KAFKA_BROKERS=kafka:9092
